# Servers, the public URL and the secret are set on the setup page, not here.
# This file is optional; add it to compose.yml under env_file if you use it.

# REFRESH_INTERVAL=15m
# PORT=8080
# LOG_LEVEL=info
# LOG_FORMAT=text

# Optional: seed one Navidrome server on first startup.
# All three must be set together. Once seeded, servers can be managed via /setup.
# NAVIDROME_URL=http://navidrome:4533
# NAVIDROME_USERNAME=myuser
# NAVIDROME_PASSWORD=mypassword
